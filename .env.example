# Variable NAMES only. Real values live in your OS keychain or secrets manager
# (on Railway: service variables) and reach each service as environment variables.

# Bearer key shared by the gateway (--api-key-env CHAINAIM_GATEWAY_KEY) and the paywall
CHAINAIM_GATEWAY_KEY=

# Gateway: OpenRouter key for the free chat models and Jev (--model-source openrouter-free)
OPENROUTER_API_KEY=

# Paywall (services/paywall): x402 payments in RLUSD on the XRP Ledger.
# XRPL_NETWORK picks testnet (the default) or mainnet. Every ledger value comes as a
# _TESTNET / _MAINNET pair; only the chosen network's values are read and checked.
XRPL_NETWORK=
# The account every route pays (r...). It needs a trust line to the RLUSD issuer.
XRPL_PAY_TO_TESTNET=
XRPL_PAY_TO_MAINNET=
# RLUSD issuer. TestNet has a default; MainNet has none: copy it from Ripple's documentation at deploy time.
RLUSD_ISSUER_TESTNET=
RLUSD_ISSUER_MAINNET=
# Optional; each has a default (see services/paywall/src/config.ts)
XRPL_CAIP2_TESTNET=
XRPL_CAIP2_MAINNET=
FACILITATOR_URL_TESTNET=
FACILITATOR_URL_MAINNET=
RLUSD_CURRENCY_CODE=
XRPL_SOURCE_TAG=
XRPL_MAX_TIMEOUT_SECONDS=
GATEWAY_URL=
PUBLIC_BASE_URL=
# Price per call in USD, 1 to 6 decimals; each defaults to $0.01 when unset
PRICE_SCAN=
PRICE_MASK=
PRICE_CHAT=

# Paywall scripts only (services/paywall/scripts): never set on a service, never committed.
# The family seed (s...) of the account that signs: the buyer in pay.ts and private-ask.ts.
XRPL_BUYER_SEED_TESTNET=
XRPL_BUYER_SEED_MAINNET=
# Test rig (scripts/rig.ts): one buyer seed per tenant, named by "seedPrefix" in rig/tenants/<id>/tenant.json.
XRPL_SEED_T01_TESTNET=
XRPL_SEED_T02_TESTNET=
XRPL_SEED_T03_TESTNET=
# The ledger's WebSocket address. TestNet has a default; MainNet has none.
XRPL_WS_URL_TESTNET=
XRPL_WS_URL_MAINNET=

# Per-deployment upstream keys, referenced by "apiKeyEnv" in config/catalog.json
# CHAINAIM_OPENAI_KEY=
# CHAINAIM_ANTHROPIC_KEY=
# CHAINAIM_GPU_CLOUD_KEY=
